{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "harness-external-links",
  "description": "Allow the embedded loopback Harness UI to open external web links in the system browser",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "permissions": [
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
